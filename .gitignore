# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Training artifacts — never commit large binaries.
# No trailing slash: these are symlinks to native WSL storage (see
# docs/ROADMAP.md), and a trailing-slash pattern only matches real
# directories, not a symlink pointing at one.
*.pt
*.pth
*.onnx
*.tflite
checkpoints
selfplay_games
logs/
runs

# Env / secrets
.env
